# Paper-only defaults. Never commit real credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_PAPER is also accepted as a compatibility alias for PAPER_TRADING.
ALPACA_PAPER=true
LIVE_TRADING=false
DRY_RUN=true
# Live submission additionally requires this exact acknowledgement:
LIVE_TRADING_ACKNOWLEDGEMENT=
CONFIG_PATH=config/default.yaml
